{
  "name": "fishertown",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "node scripts/verify-source.mjs",
    "predev": "node scripts/optimize-art.mjs",
    "prebuild": "node scripts/optimize-art.mjs",
    "postbuild": "node scripts/prune-dist.mjs",
    "smoke": "playwright test",
    "atlas:check": "node scripts/build-fish-atlas.mjs --check",
    "atlas:build": "node scripts/build-fish-atlas.mjs --write"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "sharp": "^0.34.3",
    "@playwright/test": "^1.56.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
